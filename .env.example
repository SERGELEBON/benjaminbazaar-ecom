# Supabase PostgreSQL — injected automatically on Vercel by the Supabase integration.
# For local development, copy them from Vercel > Storage > ijobsc-db > .env.local tab.
POSTGRES_PRISMA_URL="postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://...pooler.supabase.com:5432/postgres"
